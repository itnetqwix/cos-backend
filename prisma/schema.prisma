datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CREATOR
}

enum TesterApplicationStatus {
  PENDING
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
}

enum TesterStatus {
  NOT_VERIFIED
  VERIFIED
  SUSPENDED
  REVOKED
}

// Creator management access. ACTIVE is the default for every user.
// Only CREATOR rows are moved to BLOCKED. ADMIN is not blocked by this flow.
enum AccountStatus {
  ACTIVE
  BLOCKED
}

// Generic creator timeline. Moderation AuditLog stays a decision record.
// This log is the admin view of what a creator did and what an admin did to them.
enum CreatorActivityAction {
  REGISTERED
  LOGGED_IN
  SUBMISSION_UPLOADED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  SUBMISSION_FLAGGED
  SUBMISSION_DELETED
  BLOCKED
  UNBLOCKED
  WARNED
}

model User {
  id                      String               @id @default(uuid())
  email                   String               @unique
  passwordHash            String
  name                    String
  role                    Role                 @default(CREATOR)
  accountStatus           AccountStatus        @default(ACTIVE)
  testerStatus            TesterStatus         @default(NOT_VERIFIED)
  reviewApprovalEnabled   Boolean              @default(false)
  testerBio               String?              @db.Text
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  submissions             Submission[]         @relation("CreatedByUser")
  moderatedSubmissions    Submission[]         @relation("ModeratedByUser")
  deletedSubmissions      Submission[]         @relation("DeletedByUser")
  auditLogs               AuditLog[]
  ratings                 Rating[]
  comments                Comment[]
  warningsReceived        CreatorWarning[]     @relation("WarningSubject")
  warningsIssued          CreatorWarning[]     @relation("WarningIssuer")
  activityAsSubject       CreatorActivityLog[] @relation("ActivitySubject")
  activityPerformed       CreatorActivityLog[] @relation("ActivityActor")
  friendshipsAsLow        Friendship[]         @relation("FriendshipLow")
  friendshipsAsHigh       Friendship[]         @relation("FriendshipHigh")
  chatMessagesSent        ChatMessage[]        @relation("ChatMessageSender")
  chatReads               ChatRead[]           @relation("ChatReadUser")
  notifications           Notification[]
  reviewsAuthored         ProductReview[]      @relation("ReviewTester")
  reviewsApproved         ProductReview[]      @relation("ReviewApprover")
  reviewsDeleted          ProductReview[]      @relation("ReviewDeleter")
  reviewRevisionsAuthored ReviewRevision[]     @relation("ReviewRevisionAuthor")
  testerApplications      TesterApplication[]  @relation("UserTesterApplications")
  reviewedApplications    TesterApplication[]  @relation("ApplicationReviewer")
  testerAuditActions      TesterAuditLog[]     @relation("TesterAuditActor")
  testerAuditTargets      TesterAuditLog[]     @relation("TesterAuditTarget")
  submittedProducts       Product[]            @relation("ProductSubmitter")
  reviewedProducts        Product[]            @relation("ProductReviewer")
  categoryProposals       ReviewCategoryProposal[] @relation("CategoryProposals")
  reviewedCategoryProposals ReviewCategoryProposal[] @relation("CategoryProposalReviews")
  reviewsCreatedForTesters ProductReview[]     @relation("ReviewAdminCreator")
  tokeAuditLogs           TokeAuditLog[]       @relation("TokeAuditActor")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  emailVerifiedAt         DateTime?
  zooteerRoomsHosted      ZooteerRoom[]        @relation("ZooteerRoomHost")
  zooteerRoomsCreated     ZooteerRoom[]        @relation("ZooteerRoomCreator")
  zooteerRoomsClosed      ZooteerRoom[]        @relation("ZooteerRoomCloser")
  zooteerRoomsArchived    ZooteerRoom[]        @relation("ZooteerRoomArchiver")
  zooteerParticipants     ZooteerParticipant[] @relation("ZooteerParticipantUser")
  zooteerRoomEvents       ZooteerRoomEvent[]   @relation("ZooteerRoomEventActor")
  zooteerAuditLogs        ZooteerAuditLog[]    @relation("ZooteerAuditActor")
  zooteerInvitationsReceived ZooteerInvitation[] @relation("ZooteerInvitationInvitee")
  zooteerInvitationsCreated  ZooteerInvitation[] @relation("ZooteerInvitationCreator")
  zooteerReportsFiled        ZooteerAbuseReport[] @relation("ZooteerReportReporter")
  zooteerReportsReceived     ZooteerAbuseReport[] @relation("ZooteerReportSubject")
  zooteerReportsReviewed     ZooteerAbuseReport[] @relation("ZooteerReportReviewer")
  datingProfile              DatingProfile?
  datingReportsReviewed      DatingReport[]       @relation("DatingReportReviewer")

  // Private storage key for the creator profile image.
  // The API returns a short-lived presigned avatarUrl. That URL is not stored.
  // handle remains PLANNED and is not a column (M02-P01-T05 / T06).
  avatarObjectKey String?

  // User preferences and onboarding tracking
  pledgeIntroSeenAt       DateTime?
  pledgeIntroVersion      String?

  // handle is a domain-model PLANNED field.
  // Persistence (nullability, uniqueness, @-prefix format) is NOT SPECIFIED.

  @@index([role, accountStatus])
  @@index([role, createdAt])
  @@index([testerStatus])
  @@index([reviewApprovalEnabled])
  @@map("users")
}

// M05-P01-T01. Master-plan transitions only:
// DRAFT → SCHEDULED → ACTIVE → JUDGING → COMPLETED → ARCHIVED.
// CANCELLED is drawn in the pre-M05 domain diagram and listed in the old
// planned snippet, but master plan says CANCELLED triggers are NOT SPECIFIED.
// Suspension is also NOT SPECIFIED as a status. Neither value is persisted.
enum ContestStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  JUDGING
  COMPLETED
  ARCHIVED
}

// Slug is unique for this deployment. There is no organization scope.
model Category {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  contests    Contest[]
  submissions Submission[]
  isActive    Boolean      @default(true)
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  @@map("categories")
}

// M05-P01-T03 / T04. Submission relation added in M06-P01.
// categoryId is optional. autoAdvanceDelayMs default is 1800.
// Evaluation-criteria columns are NOT SPECIFIED and are not added.
// Prize distribution breakdown is NOT SPECIFIED; only prizeSummary is stored.
model Contest {
  id                 String        @id @default(uuid())
  categoryId         String?
  category           Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title              String
  description        String        @db.Text
  // Optional creator-facing copy and visuals chosen in the admin form.
  // Prize breakdown beyond prizeSummary remains NOT SPECIFIED.
  tagline            String?
  bannerUrl          String?
  // Stable private-bucket key. Display URLs are signed at read time.
  bannerObjectKey    String?
  thumbnailUrl       String?
  status             ContestStatus @default(DRAFT)
  // IANA zone used to interpret and display the schedule. Instants stay UTC.
  timezone           String        @default("Asia/Kolkata")
  startDate          DateTime
  endDate            DateTime
  // Null on contests created before voting closure was stored separately.
  votingClosesAt     DateTime?
  // Pledge monthly instance. seriesSlug has no default: a "pledge" default would
  // label every existing contest as that series. cycleMonth is YYYY-MM.
  // A template row has seriesSlug set and cycleMonth null. There is no pause
  // column: DRAFT means future generation is paused, any other status means
  // enabled. Generated months do not copy that status. configFrozenAt is set
  // on the generated month. The frozen values stay on that row.
  seriesSlug         String?
  cycleMonth         String?
  isRecurringMonthly Boolean       @default(false)
  minOverallVoters   Int           @default(10)
  minCategoryVoters  Int           @default(5)
  configFrozenAt     DateTime?
  isWinnersFinalized Boolean       @default(false)
  winnersFinalizedAt DateTime?
  winnersData        Json?
  // Frozen Pledge scoring dimensions. Null means the approved example set
  // until an admin saves a list. Overall stays on Rating.rating.
  // One Toke ReviewCategory is a different model and is not used here.
  scoringCategories     Json?
  combinedScoreEnabled  Boolean @default(false)
  // Pledge cycle settings. Null on ordinary contests and One Toke.
  // Copied from the template when a month is generated. Template edits do
  // not rewrite an existing month. There is no product default for the count
  // or the upload ceiling: Admin stores the values for that cycle.
  winnerCount              Int?
  maxVideoSizeMb           Int?
  maxVideoDurationSeconds  Int?
  allowedVideoFormats      Json?
  rankingNeedsReview       Boolean @default(false)
  prizeSummary       String?
  rules              Json?
  autoAdvanceDelayMs Int           @default(1800)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  submissions        Submission[]

  @@unique([seriesSlug, cycleMonth])
  @@index([seriesSlug, status])
  @@index([status])
  @@map("contests")
}

// M06-P01-T01. Initial ingest state is PENDING_REVIEW (BR-VID-01).
// APPROVED / REJECTED / FLAGGED are written by ModerationService (M07).
enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  FLAGGED
}

enum VideoDomain {
  REGULAR
  PLEDGE
}

// M06-P01-T02 / T03 plus M07 moderation decision columns.
// objectKey is unique so complete can retry the same reserved key.
// thumbnailUrl is optional: thumbnail generation is NOT SPECIFIED.
// rejectionReason, moderatedById, and moderatedAt are written only by moderation.
// Community score and totalVotes are updated by JudgingService (M08).
model Submission {
  id                 String           @id @default(uuid())
  domain             VideoDomain      @default(REGULAR)
  contestId          String
  contest            Contest          @relation(fields: [contestId], references: [id], onDelete: Cascade)
  creatorId          String
  creator            User             @relation("CreatedByUser", fields: [creatorId], references: [id], onDelete: Cascade)
  title              String
  description        String?          @db.Text
  videoUrl           String
  objectKey          String           @unique
  thumbnailUrl       String?
  durationSeconds    Int
  status             SubmissionStatus @default(PENDING_REVIEW)
  rejectionReason    String?          @db.Text
  moderatedById      String?
  moderatedBy        User?            @relation("ModeratedByUser", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt        DateTime?
  tags               String[]
  communityScore     Float            @default(0)
  totalVotes         Int              @default(0)
  // Creator soft delete. Null means the row is still active.
  // The row, its ratings, and the S3 object are kept.
  deletedAt          DateTime?
  deletedById        String?
  deletedBy          User?            @relation("DeletedByUser", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  categoryId         String?
  videoCategory      Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  otherCategoryLabel String?
  ratings            Rating[]
  auditLogs          AuditLog[]
  comments           Comment[]

  @@index([contestId, status])
  @@index([categoryId])
  @@index([creatorId])
  @@index([domain, status])
  @@index([domain, createdAt])
  @@map("submissions")
}

// M07-P01-T01. Documented actions from the planned data model.
// ISSUE_WARNING and SUSPEND_CREATOR are stored enum values only.
// M07 does not expose warning or suspension endpoints (those workflows
// are not specified as moderation routes).
enum AuditAction {
  APPROVE
  REJECT
  FLAG
  ISSUE_WARNING
  SUSPEND_CREATOR
  CORRECT_WINNER
  // Recurring template writes. submissionId stays null.
  // Pause is the template row status DRAFT, not a contest-lifecycle pause.
  RECURRENCE_CREATE
  RECURRENCE_UPDATE
  RECURRENCE_PAUSE
  RECURRENCE_RESUME
}

// M07-P01-T01. Append-only. Retention / purge is NOT SPECIFIED.
// metadata holds previousStatus and newStatus for the decision.
// reasonCode, when the client sends one, is stored in metadata and is
// not a closed taxonomy (source chapters do not enumerate categories).
model AuditLog {
  id           String      @id @default(uuid())
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  actorId      String
  actor        User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action       AuditAction
  reason       String?     @db.Text
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([actorId])
  @@index([submissionId])
  @@map("audit_logs")
}

// M08-P01-T01 / T02. M01-P01-T02 adds guest token identity.
// Authenticated votes are unique on (submissionId, userId).
// Guest votes are unique on (submissionId, guestVoterId).
// Both columns are nullable. PostgreSQL unique indexes allow multiple NULLs,
// so existing rows stay valid.
// voterIpHash is an HMAC of the client IP. It is anti-abuse metadata, not voter identity.
// Uniqueness is (submissionId, userId) and (submissionId, guestVoterId).
// PostgreSQL unique indexes allow multiple NULLs, so historical rows without
// those ids stay valid. A non-unique index remains for IP queries.
// voterFingerprint is optional client metadata and is not the vote key.
// New ratings are integers 1–10, enforced in Zod and JudgingService.
// There is no database CHECK, so historical 1–5 rows stay valid. Do not migrate them.
model Rating {
  id               String     @id @default(uuid())
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestVoterId     String?
  voterFingerprint String?
  voterIpHash      String?
  rating           Int
  // Pledge category integers keyed by scoring category slug. Missing keys
  // are omitted from that category's mean. They are not stored as zero.
  categoryScores   Json?
  createdAt        DateTime   @default(now())

  @@unique([submissionId, userId])
  @@unique([submissionId, guestVoterId])
  @@index([submissionId])
  @@index([voterIpHash, submissionId])
  @@index([voterFingerprint, submissionId])
  @@map("ratings")
}

// Comments are stored on the submission, not the contest.
// Guest comment authorship is NOT SPECIFIED in the product source.
// authorId is required. Ordering and maximum length are NOT SPECIFIED;
// the API uses newest-first and an engineering body cap.
// onDelete Cascade removes comments with their submission or author.
// It does not remove the contest or other creators' submissions.
model Comment {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String     @db.Text
  createdAt    DateTime   @default(now())

  @@index([submissionId, createdAt])
  @@map("comments")
}

// Administrative warning. No automatic block, threshold, or creator notification.
// A product rule for those behaviors is NOT SPECIFIED.
model CreatorWarning {
  id         String   @id @default(uuid())
  creatorId  String
  creator    User     @relation("WarningSubject", fields: [creatorId], references: [id], onDelete: Cascade)
  issuedById String
  issuedBy   User     @relation("WarningIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  reason     String   @db.Text
  createdAt  DateTime @default(now())

  @@index([creatorId, createdAt])
  @@map("creator_warnings")
}

// Append-only creator timeline. relatedSubmissionId and relatedContestId are
// plain ids, not foreign keys, so a deleted submission still leaves the event.
// metadata must not contain passwords, JWTs, or storage credentials.
model CreatorActivityLog {
  id                  String                @id @default(uuid())
  creatorId           String
  creator             User                  @relation("ActivitySubject", fields: [creatorId], references: [id], onDelete: Cascade)
  action              CreatorActivityAction
  description         String?               @db.Text
  metadata            Json?
  relatedSubmissionId String?
  relatedContestId    String?
  performedByUserId   String?
  performedBy         User?                 @relation("ActivityActor", fields: [performedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now())

  @@index([creatorId, createdAt])
  @@index([relatedContestId])
  @@index([relatedSubmissionId])
  @@map("creator_activity_logs")
}

// Creator friends. One row per unordered pair of users.
// userLowId is the smaller id so the unique pair cannot be stored twice.
// requesterId is always one of those two ids (enforced in the migration CHECK).
// It has no third foreign key, so deleting a user cascades once through low or high.
// Contest, submission, rating, and leaderboard rows are not related.
// Chat rows reference this friendship and are deleted with it.
enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id           String           @id @default(uuid())
  userLowId    String
  userHighId   String
  requesterId  String
  status       FriendshipStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  userLow      User             @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh     User             @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  chatMessages ChatMessage[]
  chatReads    ChatRead[]

  @@unique([userLowId, userHighId])
  @@index([userLowId, status])
  @@index([userHighId, status])
  @@map("friendships")
}

// One-to-one creator chat. Only an accepted friendship may have messages.
// The migration trigger enforces that the sender is one of the two friends.
// A separate product limit for body length is NOT SPECIFIED. The column check
// uses 2000 characters, the same engineering default as ChatService.
enum ChatAttachmentKind {
  IMAGE
  VIDEO
}

model ChatMessage {
  id              String              @id @default(uuid())
  friendshipId    String
  senderId        String
  body            String?             @db.Text
  attachmentKey   String?             @unique
  attachmentKind  ChatAttachmentKind?
  attachmentMime  String?
  attachmentBytes Int?
  createdAt       DateTime            @default(now())
  friendship      Friendship          @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  sender          User                @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([friendshipId, createdAt])
  @@map("chat_messages")
}

// lastReadAt is the newest moment this creator has seen the conversation.
model ChatRead {
  friendshipId String
  userId       String
  lastReadAt   DateTime   @default(now())
  friendship   Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  user         User       @relation("ChatReadUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([friendshipId, userId])
  @@map("chat_reads")
}

// In-app notifications. submissionId is a plain id, not a foreign key, so a
// deleted submission still leaves the notification. The unique key makes a
// repeated event for the same user and submission a no-op.
enum NotificationType {
  SUBMISSION_PENDING_REVIEW
  SUBMISSION_APPROVED
  SUBMISSION_DELETED
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  title        String
  body         String?          @db.Text
  submissionId String?
  readAt       DateTime?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, submissionId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Singleton baseline for the public hits clock.
// The displayed count is calculated from this row. It is not sampled every second.
model RipskisCounter {
  id                       String   @id @default("singleton")
  startingEstimate         String
  remainderMicros          Int      @default(0)
  anchorAt                 DateTime
  paused                   Boolean  @default(false)
  frozenHits               String?
  baseRatePerSecond        Float
  estimatedUsers           String   @default("256000000")
  averageUsesPerUserPerDay Float    @default(3.2)
  manualRatePerSecond      Float?
  useAssumptions           Boolean  @default(false)
  weekdayMultipliers       Json
  fridayBoost              Float
  weekendBoost             Float
  april20Multiplier        Float
  specialMonth             Int      @default(4)
  specialDay               Int      @default(20)
  specialMode              String   @default("override")
  specialDates             Json     @default("[]")
  pendingConfig            Json?
  enabled                  Boolean  @default(true)
  timezone                 String
  provisional              Boolean  @default(true)
  title                    String
  subtitle                 String
  updatedAt                DateTime @updatedAt
  updatedById              String?

  @@map("ripskis_counter")
}

// Append-only admin history for the hits clock. Invalid updates are not recorded.
model RipskisCounterAudit {
  id        String   @id @default(uuid())
  actorId   String
  createdAt DateTime @default(now())
  before    Json
  after     Json

  @@index([createdAt])
  @@map("ripskis_counter_audits")
}

// M01-P01-T01. One Toke Challenge. REMOVED is soft delete (deletedAt), not a status.
enum ReviewStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  DISQUALIFIED
}

model ProductType {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("product_types")
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Product {
  id                 String                @id @default(uuid())
  name               String
  brandName          String
  productTypeId      String
  productType        ProductType           @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  description        String?               @db.Text
  imageUrl           String?
  imageObjectKey     String?
  strain             String?
  batchNumber        String?
  reportedThcPercent Float?
  reportedCbdPercent Float?
  isActive           Boolean               @default(true)
  approvalStatus     ProductApprovalStatus @default(APPROVED)
  submittedById      String?
  submittedBy        User?                 @relation("ProductSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  rejectionReason    String?               @db.Text
  reviewedById       String?
  reviewedBy         User?                 @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  reviews            ProductReview[]
  revisions          ReviewRevision[]

  @@unique([brandName, name, productTypeId])
  @@index([productTypeId])
  @@index([approvalStatus, isActive])
  @@index([brandName])
  @@index([name])
  @@map("products")
}

model ReviewCategory {
  id            String                   @id @default(uuid())
  name          String
  slug          String                   @unique
  description   String?                  @db.Text
  defaultWeight Float                    @default(1.0)
  sortOrder     Int                      @default(0)
  isActive      Boolean                  @default(true)
  mergedIntoId  String?
  mergedInto    ReviewCategory?          @relation("CategoryMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom    ReviewCategory[]         @relation("CategoryMerges")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  scores        ReviewCategoryScore[]
  proposals     ReviewCategoryProposal[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("review_categories")
}

enum CategoryProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReviewCategoryProposal {
  id                 String                 @id @default(uuid())
  name               String
  description        String                 @db.Text
  status             CategoryProposalStatus @default(PENDING)
  proposerId         String
  proposer           User                   @relation("CategoryProposals", fields: [proposerId], references: [id], onDelete: Cascade)
  reviewedById       String?
  reviewedBy         User?                  @relation("CategoryProposalReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewReason       String?                @db.Text
  reviewedAt         DateTime?
  approvedCategoryId String?
  approvedCategory   ReviewCategory?        @relation(fields: [approvedCategoryId], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status])
  @@index([proposerId])
  @@map("review_category_proposals")
}

// publishedRevisionId is a plain id, not a foreign key. A FK back to ReviewRevision
// cycles with reviewId and blocks deleting the review while it points at a revision.
model ProductReview {
  id                  String                @id @default(uuid())
  productId           String
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  testerId            String
  tester              User                  @relation("ReviewTester", fields: [testerId], references: [id], onDelete: Cascade)
  status              ReviewStatus          @default(DRAFT)
  dispensaryName      String?
  dispensaryAddress   String?
  city                String?
  state               String?
  country             String?               @default("USA")
  videoUrl            String
  videoObjectKey      String                @unique
  thumbnailUrl        String?
  durationSeconds     Int
  overallScore        Float                 @default(0)
  weightsSnapshot     Json
  reviewNotes         String?               @db.Text
  changeRequestNotes  String?               @db.Text
  rejectionReason     String?               @db.Text
  createdByAdminId    String?
  createdByAdmin      User?                 @relation("ReviewAdminCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  approvedById        String?
  approvedBy          User?                 @relation("ReviewApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  publishedAt         DateTime?
  publishedRevisionId String?
  deletedAt           DateTime?
  deletedById         String?
  deletedBy           User?                 @relation("ReviewDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  categoryScores      ReviewCategoryScore[]
  revisions           ReviewRevision[]

  @@index([productId, status])
  @@index([testerId, status])
  @@index([status, publishedAt])
  @@index([status, overallScore])
  @@index([createdByAdminId])
  @@map("product_reviews")
}

model ReviewCategoryScore {
  id            String         @id @default(uuid())
  reviewId      String
  review        ProductReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  categoryId    String
  category      ReviewCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  score         Int
  weightApplied Float

  @@unique([reviewId, categoryId])
  @@index([reviewId])
  @@index([categoryId])
  @@map("review_category_scores")
}

// productId, durationSeconds, and changeRequestNotes are material snapshot columns
// from the readiness report. Checklist step 7 omitted them; M02 snapshotting needs them.
model ReviewRevision {
  id                 String        @id @default(uuid())
  reviewId           String
  review             ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  version            Int
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  overallScore       Float
  scoresSnapshot     Json
  weightsSnapshot    Json
  productSnapshot    Json
  videoObjectKey     String
  videoUrl           String
  thumbnailUrl       String?
  durationSeconds    Int
  reviewNotes        String?       @db.Text
  changeRequestNotes String?       @db.Text
  dispensaryName     String?
  dispensaryAddress  String?
  city               String?
  state              String?
  country            String?       @default("USA")
  changedById        String
  changedBy          User          @relation("ReviewRevisionAuthor", fields: [changedById], references: [id], onDelete: Restrict)
  changeReason       String?
  createdAt          DateTime      @default(now())

  @@unique([reviewId, version])
  @@index([reviewId])
  @@map("review_revisions")
}

// Phase 2: Verified Tester Onboarding & Verification
model TesterApplication {
  id                        String                  @id @default(uuid())
  userId                    String
  user                      User                    @relation("UserTesterApplications", fields: [userId], references: [id], onDelete: Cascade)
  status                    TesterApplicationStatus @default(PENDING)
  fullName                  String
  email                     String
  phoneNumber               String?
  avatarUrl                 String?
  city                      String?
  state                     String?
  country                   String?                 @default("USA")
  bio                       String?                 @db.Text
  experienceYears           Int?
  preferredProductTypes     String[]                @default([])
  languages                 String[]                @default([])
  credentials               String?                 @db.Text
  sampleReviewUrl           String?
  portfolioUrls             String[]                @default([])
  applicantNotes            String?                 @db.Text
  informationRequestedNotes String?                 @db.Text
  informationResponseNotes  String?                 @db.Text
  rejectionReason           String?                 @db.Text
  reviewedById              String?
  reviewedBy                User?                   @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  auditLogs                 TesterAuditLog[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("tester_applications")
}

// Audit history for tester application and access decisions
model TesterAuditLog {
  id            String             @id @default(uuid())
  actorId       String
  actor         User               @relation("TesterAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUserId  String
  targetUser    User               @relation("TesterAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  applicationId String?
  application   TesterApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  action        String             // SUBMIT, REVIEW, REQUEST_INFO, RESPOND_INFO, APPROVE, REJECT, SUSPEND, REVOKE, REINSTATE
  reason        String?            @db.Text
  metadata      Json?
  createdAt     DateTime           @default(now())

  @@index([targetUserId])
  @@index([applicationId])
  @@index([actorId])
  @@index([createdAt])
  @@map("tester_audit_logs")
}

// Unified administrative audit history for One Toke Challenge
model TokeAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("TokeAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  entityType String   // TESTER, APPLICATION, PRODUCT, CATEGORY, PROPOSAL, REVIEW
  entityId   String
  action     String   // CREATE, UPDATE, APPROVE, REJECT, REQUEST_CHANGES, PUBLISH, DISQUALIFY, SUSPEND, REVOKE, REINSTATE, MERGE, DEACTIVATE
  reason     String?  @db.Text
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("toke_audit_logs")
}

// Password reset tokens for secure credential recovery
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

// Signup verification. Existing users are backfilled as already verified.
// Link lifetime matches password reset (60 minutes). A longer window is NOT SPECIFIED.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@map("email_verification_tokens")
}

// Planet Zooteer rooms (PZ-M02). OPEN and CLOSED only. FULL is not stored.
// Capacity 2–20 is also a CHECK in the PZ-M02 migration.
// deletedAt hides a room from ordinary reads. Rows are not physically deleted.
// idleTimeoutSeconds default 3600 is an engineering default; the product
// decision is "configurable" and did not name a duration.
enum ZooteerRoomStatus {
  OPEN
  CLOSED
}

enum ZooteerParticipantStatus {
  ACTIVE
  LEFT
}

enum ZooteerParticipantRole {
  HOST
  PARTICIPANT
}

enum ZooteerRoomEventType {
  ROOM_CREATED
  ROOM_CLOSED
  ROOM_ARCHIVED
  INVITATION_CREATED
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  MEDIA_PROVISIONED
  PARTICIPANT_DISCONNECTED
  PARTICIPANT_RECONNECTED
  PARTICIPANT_GRACE_EXPIRED
}

enum ZooteerAuditAction {
  ROOM_CREATE
  ROOM_CLOSE
  ROOM_ARCHIVE
  INVITE_CREATE
  INVITE_REVOKE
  INVITE_ACCEPT
  INVITE_EMAIL
  MEDIA_TOKEN
  MEDIA_CLEANUP
  REPORT_CREATE
  REPORT_REVIEW
  REPORT_RESOLVE
}

model ZooteerRoom {
  id                 String            @id @default(uuid())
  // Stable human-friendly join code. Invitations stay account-bound.
  code               String            @unique
  name               String
  description        String?           @db.Text
  status             ZooteerRoomStatus @default(OPEN)
  hostId             String
  host               User              @relation("ZooteerRoomHost", fields: [hostId], references: [id], onDelete: Restrict)
  createdById        String
  createdBy          User              @relation("ZooteerRoomCreator", fields: [createdById], references: [id], onDelete: Restrict)
  maxParticipants    Int               @default(20)
  idleTimeoutSeconds Int               @default(3600)
  closedAt           DateTime?
  closedById         String?
  closedBy           User?             @relation("ZooteerRoomCloser", fields: [closedById], references: [id], onDelete: Restrict)
  deletedAt          DateTime?
  deletedById        String?
  deletedBy          User?             @relation("ZooteerRoomArchiver", fields: [deletedById], references: [id], onDelete: Restrict)
  // Unguessable LiveKit room name. Null until the first eligible media token.
  livekitRoomName    String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  participants       ZooteerParticipant[]
  events             ZooteerRoomEvent[]
  auditLogs          ZooteerAuditLog[]
  invitations        ZooteerInvitation[]
  abuseReports       ZooteerAbuseReport[]

  // (deletedAt, status, createdAt) serves ordinary listings. Separate
  // status/createdAt indexes would repeat that prefix.
  @@index([deletedAt, status, createdAt])
  @@index([createdById])
  @@index([hostId])
  @@map("zooteer_rooms")
}

// One row per user per room. Reconnection updates this row.
model ZooteerParticipant {
  id              String                   @id @default(uuid())
  roomId          String
  room            ZooteerRoom              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  userId          String
  user            User                     @relation("ZooteerParticipantUser", fields: [userId], references: [id], onDelete: Restrict)
  status          ZooteerParticipantStatus @default(ACTIVE)
  participantRole ZooteerParticipantRole
  firstJoinedAt   DateTime
  lastJoinedAt    DateTime
  leftAt          DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([roomId, userId])
  @@index([roomId, status])
  @@index([userId])
  @@map("zooteer_participants")
}

// Durable lifecycle events. Chat and emoji are not stored.
model ZooteerRoomEvent {
  id          String               @id @default(uuid())
  roomId      String
  room        ZooteerRoom          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  actorUserId String
  actor       User                 @relation("ZooteerRoomEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  type        ZooteerRoomEventType
  payload     Json?
  createdAt   DateTime             @default(now())

  @@index([roomId, createdAt])
  @@map("zooteer_room_events")
}

// Planet Zooteer admin history. Not the contest moderation AuditLog.
model ZooteerAuditLog {
  id          String             @id @default(uuid())
  roomId      String
  room        ZooteerRoom        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  actorUserId String
  actor       User               @relation("ZooteerAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      ZooteerAuditAction
  reason      String?            @db.Text
  metadata    Json?
  createdAt   DateTime           @default(now())

  @@index([roomId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("zooteer_audit_logs")
}

// One usable invitation per room and user is enforced by a partial unique
// index in the PZ-M03 migration (acceptedAt and revokedAt both null).
// The raw token is never stored. expiresAt is absolute; there is no EXPIRED status.
model ZooteerInvitation {
  id            String    @id @default(uuid())
  roomId        String
  room          ZooteerRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  inviteeUserId String
  invitee       User      @relation("ZooteerInvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Restrict)
  tokenHash     String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdById   String
  createdBy     User      @relation("ZooteerInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([roomId, createdAt])
  @@index([inviteeUserId, expiresAt])
  @@map("zooteer_invitations")
}

// Durable moderation report. The description is the reporter's reason.
// Chat transcripts are not a column and must not be copied into metadata.
enum ZooteerReportCategory {
  HARASSMENT
  HATE
  SEXUAL
  VIOLENCE
  SPAM
  OTHER
}

enum ZooteerReportStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model ZooteerAbuseReport {
  id             String                 @id @default(uuid())
  roomId         String
  room           ZooteerRoom            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reporterId     String
  reporter       User                   @relation("ZooteerReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reportedUserId String
  reportedUser   User                   @relation("ZooteerReportSubject", fields: [reportedUserId], references: [id], onDelete: Restrict)
  category       ZooteerReportCategory
  description    String?                @db.Text
  status         ZooteerReportStatus    @default(OPEN)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?                  @relation("ZooteerReportReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([roomId, createdAt])
  @@index([status, createdAt])
  @@map("zooteer_abuse_reports")
}

// ============================================================================
// 420 Dating. One optional profile per Ripskis user. Dating rows do not
// change User.name, avatarObjectKey, friendships, or contest data.
// Exact coordinates are not columns. birthDate and statedAge are never returned
// by the API. New profiles store statedAge. Existing profiles keep birthDate.
//
// Prisma cannot model the CHECK constraints, photo-limit trigger, message
// participant trigger, or partial unique primary-photo index. Those objects
// are defined in prisma/custom/420-dating-protections.sql and created by
// migration 20261120120000_add_420_dating_module. Do not drop them.
// src/services/dating-sql-guard.ts rejects a later migration that drops one
// without recreating it.
// ============================================================================

enum DatingGender {
  MAN
  WOMAN
  NON_BINARY
  TRANSGENDER
  OTHER
}

enum DatingIntention {
  LONG_TERM
  CASUAL
  PUFF_AND_PASS_FRIEND
  NEW_FRIENDS
  NOT_SURE
}

enum CannabisExperienceLevel {
  CANNA_CURIOUS
  CASUAL_PUFFER
  CONNOISSEUR
  BUDTENDER_PRO
}

enum DatingProfileStatus {
  DRAFT
  ACTIVE
  PAUSED
  BANNED
}

enum DatingVerificationStatus {
  UNVERIFIED
  PENDING_SELFIE
  VERIFIED
  REJECTED
}

enum PhotoModerationStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
}

enum LikeTargetType {
  PROFILE
  PHOTO
  PROMPT
}

enum DatingReportCategory {
  UNDERAGE
  HARASSMENT
  SOLICITATION_OR_DRUG_DEALING
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  SPAM
  OTHER
}

enum DatingReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum DatingNotificationType {
  NEW_MATCH
  NEW_LIKE
  NEW_MESSAGE
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SYSTEM_NOTICE
}

model DatingProfile {
  id                        String                   @id @default(uuid())
  userId                    String                   @unique
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName               String
  birthDate                 DateTime?
  statedAge                 Int?
  gender                    DatingGender
  interestedIn              String[]
  bio                       String?                  @db.Text
  datingIntention           DatingIntention          @default(NOT_SURE)
  consumptionHabits         String[]
  favoriteStrains           String[]
  cannabisExperienceLevel   CannabisExperienceLevel  @default(CASUAL_PUFFER)
  favoriteMethods           String[]
  lifestyleInterests        String[]
  city                      String
  state                     String
  country                   String                   @default("USA")
  latitudeFuzzy             Float?
  longitudeFuzzy            Float?
  voiceIntroObjectKey       String?                  @unique
  voiceIntroDurationSeconds Int?
  vibeAnswers               Json?
  profilePrompts            Json?
  verificationStatus        DatingVerificationStatus @default(UNVERIFIED)
  verificationPhotoKey      String?
  status                    DatingProfileStatus      @default(DRAFT)
  isIncognito               Boolean                  @default(false)
  isDistanceHidden          Boolean                  @default(false)
  isAgeHidden               Boolean                  @default(false)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  photos                    DatingPhoto[]
  preferences               DatingPreferences?
  likesSent                 DatingLike[]             @relation("DatingLikesSent")
  likesReceived             DatingLike[]             @relation("DatingLikesReceived")
  matchesAsLow              DatingMatch[]            @relation("DatingMatchLow")
  matchesAsHigh             DatingMatch[]            @relation("DatingMatchHigh")
  unmatchedMatches          DatingMatch[]            @relation("DatingMatchUnmatcher")
  messagesSent              DatingMessage[]          @relation("DatingMessageSender")
  blocksInitiated           DatingBlock[]            @relation("DatingBlocker")
  blocksReceived            DatingBlock[]            @relation("DatingBlocked")
  reportsFiled              DatingReport[]           @relation("DatingReporter")
  reportsReceived           DatingReport[]           @relation("DatingReported")
  notifications             DatingNotification[]

  @@index([status, gender])
  @@index([status, city, state])
  @@index([status, createdAt])
  @@index([status, latitudeFuzzy])
  @@index([status, longitudeFuzzy])
  @@index([userId])
  @@map("dating_profiles")
}

model DatingPhoto {
  id               String                @id @default(uuid())
  profileId        String
  profile          DatingProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  objectKey        String                @unique
  sortOrder        Int                   @default(0)
  isPrimary        Boolean               @default(false)
  caption          String?               @db.VarChar(140)
  moderationStatus PhotoModerationStatus @default(APPROVED)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([profileId, sortOrder])
  @@index([profileId, isPrimary])
  @@map("dating_photos")
}

model DatingPreferences {
  id                        String        @id @default(uuid())
  profileId                 String        @unique
  profile                   DatingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  minAge                    Int           @default(18)
  maxAge                    Int           @default(99)
  ageDealbreaker            Boolean       @default(false)
  maxDistanceMiles          Int           @default(50)
  distanceDealbreaker       Boolean       @default(false)
  targetGenders             String[]
  genderDealbreaker         Boolean       @default(false)
  cannabisHabitsFilter      String[]      @default([])
  cannabisHabitsDealbreaker Boolean       @default(false)
  intentionsFilter          String[]      @default([])
  intentionsDealbreaker     Boolean       @default(false)
  verifiedOnly              Boolean       @default(false)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@map("dating_preferences")
}

model DatingLike {
  id                String         @id @default(uuid())
  senderProfileId   String
  senderProfile     DatingProfile  @relation("DatingLikesSent", fields: [senderProfileId], references: [id], onDelete: Cascade)
  receiverProfileId String
  receiverProfile   DatingProfile  @relation("DatingLikesReceived", fields: [receiverProfileId], references: [id], onDelete: Cascade)
  isPass            Boolean        @default(false)
  comment           String?        @db.VarChar(500)
  targetType        LikeTargetType @default(PROFILE)
  targetId          String?
  createdAt         DateTime       @default(now())
  matchesOriginated DatingMatch[]

  @@unique([senderProfileId, receiverProfileId])
  @@index([receiverProfileId, isPass, createdAt])
  @@index([senderProfileId, isPass, createdAt])
  @@map("dating_likes")
}

model DatingMatch {
  id                String              @id @default(uuid())
  profileLowId      String
  profileHighId     String
  profileLow        DatingProfile       @relation("DatingMatchLow", fields: [profileLowId], references: [id], onDelete: Cascade)
  profileHigh       DatingProfile       @relation("DatingMatchHigh", fields: [profileHighId], references: [id], onDelete: Cascade)
  originatingLikeId String?
  originatingLike   DatingLike?         @relation(fields: [originatingLikeId], references: [id], onDelete: SetNull)
  matchedAt         DateTime            @default(now())
  isActive          Boolean             @default(true)
  unmatchedAt       DateTime?
  unmatchedById     String?
  unmatchedBy       DatingProfile?      @relation("DatingMatchUnmatcher", fields: [unmatchedById], references: [id], onDelete: SetNull)
  unmatchReason     String?             @db.Text
  conversation      DatingConversation?

  @@unique([profileLowId, profileHighId])
  @@index([profileLowId, isActive])
  @@index([profileHighId, isActive])
  @@map("dating_matches")
}

model DatingConversation {
  id                 String          @id @default(uuid())
  matchId            String          @unique
  match              DatingMatch     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  lastMessageAt      DateTime?
  lastMessageSnippet String?         @db.VarChar(255)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  messages           DatingMessage[]

  @@index([lastMessageAt])
  @@map("dating_conversations")
}

model DatingMessage {
  id              String              @id @default(uuid())
  conversationId  String
  conversation    DatingConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderProfileId String
  senderProfile   DatingProfile       @relation("DatingMessageSender", fields: [senderProfileId], references: [id], onDelete: Cascade)
  body            String?             @db.Text
  attachmentKey   String?             @unique
  attachmentKind  ChatAttachmentKind?
  attachmentMime  String?
  attachmentBytes Int?
  isRead          Boolean             @default(false)
  readAt          DateTime?
  createdAt       DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@map("dating_messages")
}

model DatingBlock {
  id               String        @id @default(uuid())
  blockerProfileId String
  blockerProfile   DatingProfile @relation("DatingBlocker", fields: [blockerProfileId], references: [id], onDelete: Cascade)
  blockedProfileId String
  blockedProfile   DatingProfile @relation("DatingBlocked", fields: [blockedProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())

  @@unique([blockerProfileId, blockedProfileId])
  @@index([blockerProfileId])
  @@index([blockedProfileId])
  @@map("dating_blocks")
}

model DatingReport {
  id                String               @id @default(uuid())
  reporterProfileId String
  reporterProfile   DatingProfile        @relation("DatingReporter", fields: [reporterProfileId], references: [id], onDelete: Restrict)
  reportedProfileId String
  reportedProfile   DatingProfile        @relation("DatingReported", fields: [reportedProfileId], references: [id], onDelete: Restrict)
  reasonCategory    DatingReportCategory
  details           String?              @db.Text
  evidencePhotoKeys String[]             @default([])
  status            DatingReportStatus   @default(PENDING)
  resolutionNotes   String?              @db.Text
  reviewedById      String?
  reviewedBy        User?                @relation("DatingReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([reportedProfileId])
  @@map("dating_reports")
}

model DatingNotification {
  id              String                 @id @default(uuid())
  profileId       String
  profile         DatingProfile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type            DatingNotificationType
  title           String
  body            String?                @db.Text
  relatedEntityId String?
  readAt          DateTime?
  createdAt       DateTime               @default(now())

  @@index([profileId, readAt])
  @@index([profileId, createdAt])
  @@map("dating_notifications")
}
