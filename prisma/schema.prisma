datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CREATOR
}

// Creator management access. ACTIVE is the default for every user.
// Only CREATOR rows are moved to BLOCKED. ADMIN is not blocked by this flow.
enum AccountStatus {
  ACTIVE
  BLOCKED
}

// Generic creator timeline. Moderation AuditLog stays a decision record.
// This log is the admin view of what a creator did and what an admin did to them.
enum CreatorActivityAction {
  REGISTERED
  LOGGED_IN
  SUBMISSION_UPLOADED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  SUBMISSION_FLAGGED
  SUBMISSION_DELETED
  BLOCKED
  UNBLOCKED
  WARNED
}

model User {
  id                      String               @id @default(uuid())
  email                   String               @unique
  passwordHash            String
  name                    String
  role                    Role                 @default(CREATOR)
  accountStatus           AccountStatus        @default(ACTIVE)
  testerEnabled           Boolean              @default(false)
  reviewApprovalEnabled   Boolean              @default(false)
  testerBio               String?              @db.Text
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  submissions             Submission[]         @relation("CreatedByUser")
  moderatedSubmissions    Submission[]         @relation("ModeratedByUser")
  deletedSubmissions      Submission[]         @relation("DeletedByUser")
  auditLogs               AuditLog[]
  ratings                 Rating[]
  comments                Comment[]
  warningsReceived        CreatorWarning[]     @relation("WarningSubject")
  warningsIssued          CreatorWarning[]     @relation("WarningIssuer")
  activityAsSubject       CreatorActivityLog[] @relation("ActivitySubject")
  activityPerformed       CreatorActivityLog[] @relation("ActivityActor")
  friendshipsAsLow        Friendship[]         @relation("FriendshipLow")
  friendshipsAsHigh       Friendship[]         @relation("FriendshipHigh")
  chatMessagesSent        ChatMessage[]        @relation("ChatMessageSender")
  chatReads               ChatRead[]           @relation("ChatReadUser")
  notifications           Notification[]
  reviewsAuthored         ProductReview[]      @relation("ReviewTester")
  reviewsApproved         ProductReview[]      @relation("ReviewApprover")
  reviewsDeleted          ProductReview[]      @relation("ReviewDeleter")
  reviewRevisionsAuthored ReviewRevision[]     @relation("ReviewRevisionAuthor")

  // Private storage key for the creator profile image.
  // The API returns a short-lived presigned avatarUrl. That URL is not stored.
  // handle remains PLANNED and is not a column (M02-P01-T05 / T06).
  avatarObjectKey String?

  // handle is a domain-model PLANNED field.
  // Persistence (nullability, uniqueness, @-prefix format) is NOT SPECIFIED.

  @@index([role, accountStatus])
  @@index([role, createdAt])
  @@index([testerEnabled])
  @@index([reviewApprovalEnabled])
  @@map("users")
}

// M05-P01-T01. Master-plan transitions only:
// DRAFT → SCHEDULED → ACTIVE → JUDGING → COMPLETED → ARCHIVED.
// CANCELLED is drawn in the pre-M05 domain diagram and listed in the old
// planned snippet, but master plan says CANCELLED triggers are NOT SPECIFIED.
// Suspension is also NOT SPECIFIED as a status. Neither value is persisted.
enum ContestStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  JUDGING
  COMPLETED
  ARCHIVED
}

// Slug is unique for this deployment. There is no organization scope.
model Category {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  contests    Contest[]
  submissions Submission[]
  isActive    Boolean      @default(true)
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  @@map("categories")
}

// M05-P01-T03 / T04. Submission relation added in M06-P01.
// categoryId is optional. autoAdvanceDelayMs default is 1800.
// Evaluation-criteria columns are NOT SPECIFIED and are not added.
// Prize distribution breakdown is NOT SPECIFIED; only prizeSummary is stored.
model Contest {
  id                 String        @id @default(uuid())
  categoryId         String?
  category           Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title              String
  description        String        @db.Text
  // Optional creator-facing copy and visuals chosen in the admin form.
  // Prize breakdown beyond prizeSummary remains NOT SPECIFIED.
  tagline            String?
  bannerUrl          String?
  // Stable private-bucket key. Display URLs are signed at read time.
  bannerObjectKey    String?
  thumbnailUrl       String?
  status             ContestStatus @default(DRAFT)
  // IANA zone used to interpret and display the schedule. Instants stay UTC.
  timezone           String        @default("Asia/Kolkata")
  startDate          DateTime
  endDate            DateTime
  // Null on contests created before voting closure was stored separately.
  votingClosesAt     DateTime?
  // Pledge monthly instance. seriesSlug has no default: a "pledge" default would
  // label every existing contest as that series. cycleMonth is YYYY-MM.
  // A template row has seriesSlug set and cycleMonth null. There is no pause
  // column: DRAFT means future generation is paused, any other status means
  // enabled. Generated months do not copy that status. configFrozenAt is set
  // on the generated month. The frozen values stay on that row.
  seriesSlug         String?
  cycleMonth         String?
  isRecurringMonthly Boolean       @default(false)
  minOverallVoters   Int           @default(10)
  minCategoryVoters  Int           @default(5)
  configFrozenAt     DateTime?
  isWinnersFinalized Boolean       @default(false)
  winnersFinalizedAt DateTime?
  winnersData        Json?
  // Frozen Pledge scoring dimensions. Null means the approved example set
  // until an admin saves a list. Overall stays on Rating.rating.
  // One Toke ReviewCategory is a different model and is not used here.
  scoringCategories     Json?
  combinedScoreEnabled  Boolean @default(false)
  // Pledge cycle settings. Null on ordinary contests and One Toke.
  // Copied from the template when a month is generated. Template edits do
  // not rewrite an existing month. There is no product default for the count
  // or the upload ceiling: Admin stores the values for that cycle.
  winnerCount              Int?
  maxVideoSizeMb           Int?
  maxVideoDurationSeconds  Int?
  allowedVideoFormats      Json?
  rankingNeedsReview       Boolean @default(false)
  prizeSummary       String?
  rules              Json?
  autoAdvanceDelayMs Int           @default(1800)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  submissions        Submission[]

  @@unique([seriesSlug, cycleMonth])
  @@index([seriesSlug, status])
  @@index([status])
  @@map("contests")
}

// M06-P01-T01. Initial ingest state is PENDING_REVIEW (BR-VID-01).
// APPROVED / REJECTED / FLAGGED are written by ModerationService (M07).
enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  FLAGGED
}

// M06-P01-T02 / T03 plus M07 moderation decision columns.
// objectKey is unique so complete can retry the same reserved key.
// thumbnailUrl is optional: thumbnail generation is NOT SPECIFIED.
// rejectionReason, moderatedById, and moderatedAt are written only by moderation.
// Community score and totalVotes are updated by JudgingService (M08).
model Submission {
  id                 String           @id @default(uuid())
  contestId          String
  contest            Contest          @relation(fields: [contestId], references: [id], onDelete: Cascade)
  creatorId          String
  creator            User             @relation("CreatedByUser", fields: [creatorId], references: [id], onDelete: Cascade)
  title              String
  description        String?          @db.Text
  videoUrl           String
  objectKey          String           @unique
  thumbnailUrl       String?
  durationSeconds    Int
  status             SubmissionStatus @default(PENDING_REVIEW)
  rejectionReason    String?          @db.Text
  moderatedById      String?
  moderatedBy        User?            @relation("ModeratedByUser", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt        DateTime?
  tags               String[]
  communityScore     Float            @default(0)
  totalVotes         Int              @default(0)
  // Creator soft delete. Null means the row is still active.
  // The row, its ratings, and the S3 object are kept.
  deletedAt          DateTime?
  deletedById        String?
  deletedBy          User?            @relation("DeletedByUser", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  categoryId         String?
  videoCategory      Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  otherCategoryLabel String?
  ratings            Rating[]
  auditLogs          AuditLog[]
  comments           Comment[]

  @@index([contestId, status])
  @@index([categoryId])
  @@index([creatorId])
  @@map("submissions")
}

// M07-P01-T01. Documented actions from the planned data model.
// ISSUE_WARNING and SUSPEND_CREATOR are stored enum values only.
// M07 does not expose warning or suspension endpoints (those workflows
// are not specified as moderation routes).
enum AuditAction {
  APPROVE
  REJECT
  FLAG
  ISSUE_WARNING
  SUSPEND_CREATOR
  CORRECT_WINNER
  // Recurring template writes. submissionId stays null.
  // Pause is the template row status DRAFT, not a contest-lifecycle pause.
  RECURRENCE_CREATE
  RECURRENCE_UPDATE
  RECURRENCE_PAUSE
  RECURRENCE_RESUME
}

// M07-P01-T01. Append-only. Retention / purge is NOT SPECIFIED.
// metadata holds previousStatus and newStatus for the decision.
// reasonCode, when the client sends one, is stored in metadata and is
// not a closed taxonomy (source chapters do not enumerate categories).
model AuditLog {
  id           String      @id @default(uuid())
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  actorId      String
  actor        User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action       AuditAction
  reason       String?     @db.Text
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([actorId])
  @@index([submissionId])
  @@map("audit_logs")
}

// M08-P01-T01 / T02. M01-P01-T02 adds guest token identity.
// Authenticated votes are unique on (submissionId, userId).
// Guest votes are unique on (submissionId, guestVoterId).
// Both columns are nullable. PostgreSQL unique indexes allow multiple NULLs,
// so existing rows stay valid.
// voterIpHash is an HMAC of the client IP. It is anti-abuse metadata, not voter identity.
// Uniqueness is (submissionId, userId) and (submissionId, guestVoterId).
// PostgreSQL unique indexes allow multiple NULLs, so historical rows without
// those ids stay valid. A non-unique index remains for IP queries.
// voterFingerprint is optional client metadata and is not the vote key.
// New ratings are integers 1–10, enforced in Zod and JudgingService.
// There is no database CHECK, so historical 1–5 rows stay valid. Do not migrate them.
model Rating {
  id               String     @id @default(uuid())
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestVoterId     String?
  voterFingerprint String?
  voterIpHash      String?
  rating           Int
  // Pledge category integers keyed by scoring category slug. Missing keys
  // are omitted from that category's mean. They are not stored as zero.
  categoryScores   Json?
  createdAt        DateTime   @default(now())

  @@unique([submissionId, userId])
  @@unique([submissionId, guestVoterId])
  @@index([submissionId])
  @@index([voterIpHash, submissionId])
  @@index([voterFingerprint, submissionId])
  @@map("ratings")
}

// Comments are stored on the submission, not the contest.
// Guest comment authorship is NOT SPECIFIED in the product source.
// authorId is required. Ordering and maximum length are NOT SPECIFIED;
// the API uses newest-first and an engineering body cap.
// onDelete Cascade removes comments with their submission or author.
// It does not remove the contest or other creators' submissions.
model Comment {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String     @db.Text
  createdAt    DateTime   @default(now())

  @@index([submissionId, createdAt])
  @@map("comments")
}

// Administrative warning. No automatic block, threshold, or creator notification.
// A product rule for those behaviors is NOT SPECIFIED.
model CreatorWarning {
  id         String   @id @default(uuid())
  creatorId  String
  creator    User     @relation("WarningSubject", fields: [creatorId], references: [id], onDelete: Cascade)
  issuedById String
  issuedBy   User     @relation("WarningIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  reason     String   @db.Text
  createdAt  DateTime @default(now())

  @@index([creatorId, createdAt])
  @@map("creator_warnings")
}

// Append-only creator timeline. relatedSubmissionId and relatedContestId are
// plain ids, not foreign keys, so a deleted submission still leaves the event.
// metadata must not contain passwords, JWTs, or storage credentials.
model CreatorActivityLog {
  id                  String                @id @default(uuid())
  creatorId           String
  creator             User                  @relation("ActivitySubject", fields: [creatorId], references: [id], onDelete: Cascade)
  action              CreatorActivityAction
  description         String?               @db.Text
  metadata            Json?
  relatedSubmissionId String?
  relatedContestId    String?
  performedByUserId   String?
  performedBy         User?                 @relation("ActivityActor", fields: [performedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now())

  @@index([creatorId, createdAt])
  @@index([relatedContestId])
  @@index([relatedSubmissionId])
  @@map("creator_activity_logs")
}

// Creator friends. One row per unordered pair of users.
// userLowId is the smaller id so the unique pair cannot be stored twice.
// requesterId is always one of those two ids (enforced in the migration CHECK).
// It has no third foreign key, so deleting a user cascades once through low or high.
// Contest, submission, rating, and leaderboard rows are not related.
// Chat rows reference this friendship and are deleted with it.
enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id           String           @id @default(uuid())
  userLowId    String
  userHighId   String
  requesterId  String
  status       FriendshipStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  userLow      User             @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh     User             @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  chatMessages ChatMessage[]
  chatReads    ChatRead[]

  @@unique([userLowId, userHighId])
  @@index([userLowId, status])
  @@index([userHighId, status])
  @@map("friendships")
}

// One-to-one creator chat. Only an accepted friendship may have messages.
// The migration trigger enforces that the sender is one of the two friends.
// A separate product limit for body length is NOT SPECIFIED. The column check
// uses 2000 characters, the same engineering default as ChatService.
enum ChatAttachmentKind {
  IMAGE
  VIDEO
}

model ChatMessage {
  id              String              @id @default(uuid())
  friendshipId    String
  senderId        String
  body            String?             @db.Text
  attachmentKey   String?             @unique
  attachmentKind  ChatAttachmentKind?
  attachmentMime  String?
  attachmentBytes Int?
  createdAt       DateTime            @default(now())
  friendship      Friendship          @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  sender          User                @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([friendshipId, createdAt])
  @@map("chat_messages")
}

// lastReadAt is the newest moment this creator has seen the conversation.
model ChatRead {
  friendshipId String
  userId       String
  lastReadAt   DateTime   @default(now())
  friendship   Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  user         User       @relation("ChatReadUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([friendshipId, userId])
  @@map("chat_reads")
}

// In-app notifications. submissionId is a plain id, not a foreign key, so a
// deleted submission still leaves the notification. The unique key makes a
// repeated event for the same user and submission a no-op.
enum NotificationType {
  SUBMISSION_PENDING_REVIEW
  SUBMISSION_APPROVED
  SUBMISSION_DELETED
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  title        String
  body         String?          @db.Text
  submissionId String?
  readAt       DateTime?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, submissionId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Singleton baseline for the public hits clock.
// The displayed count is calculated from this row. It is not sampled every second.
model RipskisCounter {
  id                       String   @id @default("singleton")
  startingEstimate         String
  remainderMicros          Int      @default(0)
  anchorAt                 DateTime
  paused                   Boolean  @default(false)
  frozenHits               String?
  baseRatePerSecond        Float
  estimatedUsers           String   @default("256000000")
  averageUsesPerUserPerDay Float    @default(3.2)
  manualRatePerSecond      Float?
  useAssumptions           Boolean  @default(false)
  weekdayMultipliers       Json
  fridayBoost              Float
  weekendBoost             Float
  april20Multiplier        Float
  specialMonth             Int      @default(4)
  specialDay               Int      @default(20)
  specialMode              String   @default("override")
  specialDates             Json     @default("[]")
  pendingConfig            Json?
  enabled                  Boolean  @default(true)
  timezone                 String
  provisional              Boolean  @default(true)
  title                    String
  subtitle                 String
  updatedAt                DateTime @updatedAt
  updatedById              String?

  @@map("ripskis_counter")
}

// Append-only admin history for the hits clock. Invalid updates are not recorded.
model RipskisCounterAudit {
  id        String   @id @default(uuid())
  actorId   String
  createdAt DateTime @default(now())
  before    Json
  after     Json

  @@index([createdAt])
  @@map("ripskis_counter_audits")
}

// M01-P01-T01. One Toke Challenge. REMOVED is soft delete (deletedAt), not a status.
enum ReviewStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  DISQUALIFIED
}

model ProductType {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("product_types")
}

model Product {
  id            String           @id @default(uuid())
  name          String
  brandName     String
  productTypeId String
  productType   ProductType      @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  reviews       ProductReview[]
  revisions     ReviewRevision[]

  @@unique([brandName, name, productTypeId])
  @@index([productTypeId])
  @@map("products")
}

model ReviewCategory {
  id            String                @id @default(uuid())
  name          String
  slug          String                @unique
  defaultWeight Float                 @default(1.0)
  sortOrder     Int
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  scores        ReviewCategoryScore[]

  @@map("review_categories")
}

// publishedRevisionId is a plain id, not a foreign key. A FK back to ReviewRevision
// cycles with reviewId and blocks deleting the review while it points at a revision.
model ProductReview {
  id                  String                @id @default(uuid())
  productId           String
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  testerId            String
  tester              User                  @relation("ReviewTester", fields: [testerId], references: [id], onDelete: Cascade)
  status              ReviewStatus          @default(DRAFT)
  dispensaryName      String?
  city                String?
  state               String?
  country             String?               @default("USA")
  videoUrl            String
  videoObjectKey      String                @unique
  thumbnailUrl        String?
  durationSeconds     Int
  overallScore        Float                 @default(0)
  weightsSnapshot     Json
  reviewNotes         String?               @db.Text
  changeRequestNotes  String?               @db.Text
  rejectionReason     String?               @db.Text
  approvedById        String?
  approvedBy          User?                 @relation("ReviewApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  publishedAt         DateTime?
  publishedRevisionId String?
  deletedAt           DateTime?
  deletedById         String?
  deletedBy           User?                 @relation("ReviewDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  categoryScores      ReviewCategoryScore[]
  revisions           ReviewRevision[]

  @@index([productId, status])
  @@index([testerId, status])
  @@index([status, publishedAt])
  @@index([status, overallScore])
  @@map("product_reviews")
}

model ReviewCategoryScore {
  id            String         @id @default(uuid())
  reviewId      String
  review        ProductReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  categoryId    String
  category      ReviewCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  score         Int
  weightApplied Float

  @@unique([reviewId, categoryId])
  @@index([reviewId])
  @@index([categoryId])
  @@map("review_category_scores")
}

// productId, durationSeconds, and changeRequestNotes are material snapshot columns
// from the readiness report. Checklist step 7 omitted them; M02 snapshotting needs them.
model ReviewRevision {
  id                 String        @id @default(uuid())
  reviewId           String
  review             ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  version            Int
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  overallScore       Float
  scoresSnapshot     Json
  weightsSnapshot    Json
  productSnapshot    Json
  videoObjectKey     String
  videoUrl           String
  thumbnailUrl       String?
  durationSeconds    Int
  reviewNotes        String?       @db.Text
  changeRequestNotes String?       @db.Text
  dispensaryName     String?
  city               String?
  state              String?
  country            String?       @default("USA")
  changedById        String
  changedBy          User          @relation("ReviewRevisionAuthor", fields: [changedById], references: [id], onDelete: Restrict)
  changeReason       String?
  createdAt          DateTime      @default(now())

  @@unique([reviewId, version])
  @@index([reviewId])
  @@map("review_revisions")
}
