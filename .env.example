# COS backend environment template (M01-P01-T05)
# Copy to `.env` (gitignored). Do not commit real secrets.
#
# Keys below are the only variables parsed by `src/config/env.ts`.
# None are required at Zod parse time (missing values use the defaults noted).
#
# Not an env key (omit):
# - CORS_ORIGIN — not in env.ts; CORS origin is hardcoded '*' in src/plugins/cors.ts.
#   Allowed-origin list: NOT SPECIFIED.
# - JWT_EXPIRES_IN — JWT expiry is SYSTEM_CONSTANTS.JWT_EXPIRES_IN (`7d`), not an env var.
# - AWS_REGION / AWS_S3_BUCKET / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY —
#   PLANNED (M06-P02-T01), not present in env.ts.

# Listen port. Coerced number. Default SYSTEM_CONSTANTS.DEFAULT_PORT (5000).
PORT=5000

# `development` | `production` | `test`. Default `development`.
NODE_ENV=development

# Prisma / PostgreSQL connection string (placeholder only).
# If omitted, env.ts defaults to an empty string; Fastify parse still succeeds.
# Prisma CLI and src/config/database.ts still need a real URL to connect.
# Hosted vs local provider URL: NOT SPECIFIED beyond PostgreSQL.
DATABASE_URL="postgresql://user:password@localhost:5432/cos_db"

# JWT signing secret (placeholder only — do not put production secrets here).
# If this key is omitted, env.ts applies a hardcoded fallback (value not duplicated here).
# An explicitly empty value is accepted by the schema. Minimum length / rotation: NOT SPECIFIED.
JWT_SECRET="your-super-secret-key"

# Fastify / Pino log level. Default `info`.
LOG_LEVEL=info
